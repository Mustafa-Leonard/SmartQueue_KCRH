generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(cuid())
  name                 String
  email                String               @unique
  phone                String               @unique
  password             String
  role                 String               @default("CUSTOMER")
  isActive             Boolean              @default(true)
  isLocked             Boolean              @default(false)
  lockedUntil          DateTime?
  failedLoginAttempts  Int                  @default(0)
  twoFactorEnabled     Boolean              @default(false)
  twoFactorSecret      String?
  lastLogin            DateTime?
  lastLoginIp          String?
  profileImageUrl      String?
  notificationPrefs    String?
  emergencyContact     String?
  emergencyContactName String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  address              String?
  allergies            String?
  bloodType            String?
dateOfBirth          String?
  diseases             String?
  gender               String?
  height               String?
  lastVisit            String?
  weight               String?
  activityLogs         ActivityLog[]
  apiLogs              ApiLog[]
  appointments         Appointment[]
  auditLogs            AuditLog[]
  assignedCounter      Counter?
  feedbacks            Feedback[]
  kioskSessions        KioskSession[]
  sentNotifications    Notification[]       @relation("NotificationSender")
  notifications        Notification[]
  passwordResets       PasswordResetToken[]
  createdTasks         Task[]               @relation("TaskCreator")
  assignedTasks        Task[]               @relation("TaskAssignee")
  tickets              Ticket[]
  sessions             UserSession[]

  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model Branch {
  id              String                 @id @default(cuid())
  name            String                 @unique
  description     String?
  location        String?
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  closingTime     String?                @default("17:00")
  deletedAt       DateTime?
  email           String?
  openingTime     String?                @default("08:00")
  phone           String?
  counters        Counter[]
  healthBulletins HealthBulletin[]
  announcements   HospitalAnnouncement[]
  queues          Queue[]
  services        Service[]
  tasks           Task[]

  @@map("branches")
}

model Service {
  id            String        @id @default(cuid())
  name          String
  description   String?
  estimatedTime Int           @default(10)
  isActive      Boolean       @default(true)
  branchId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  category      String?
  color         String?
  deletedAt     DateTime?
  icon          String?
  appointments  Appointment[]
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets       Ticket[]
  counters      Counter[]     @relation("CounterToService")

  @@index([branchId])
  @@map("services")
}

model Counter {
  id               String    @id @default(cuid())
  name             String
  number           Int
  status           String    @default("CLOSED")
  branchId         String
  staffId          String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  queueCapacity    Int?      @default(50)
  services         String?
  staff            User?     @relation(fields: [staffId], references: [id])
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets          Ticket[]
  serviceRelations Service[] @relation("CounterToService")

  @@index([branchId])
  @@map("counters")
}

model Queue {
  id        String    @id @default(cuid())
  date      DateTime
  branchId  String
  isOpen    Boolean   @default(true)
  isPaused  Boolean   @default(false)
  pausedAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets   Ticket[]

  @@unique([branchId, date])
  @@index([branchId, date])
  @@map("queues")
}

model Ticket {
  id            String     @id @default(cuid())
  ticketNumber  String     @unique
  ticketCode    String     @unique @default(cuid())
  status        String     @default("WAITING")
  type          String     @default("WALK_IN")
  priority      Int        @default(0)
  position      Int
  waitingBefore Int        @default(0)
  qrCodeData    String?
  calledAt      DateTime?
  servedAt      DateTime?
  completedAt   DateTime?
  notes         String?
  customerId    String
  serviceId     String
  counterId     String?
  queueId       String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  feedbacks     Feedback[]
  queue         Queue      @relation(fields: [queueId], references: [id])
  counter       Counter?   @relation(fields: [counterId], references: [id])
  service       Service    @relation(fields: [serviceId], references: [id])
  customer      User       @relation(fields: [customerId], references: [id])

  @@index([queueId, status])
  @@index([customerId])
  @@index([ticketNumber])
  @@index([status])
  @@map("tickets")
}

model Appointment {
  id                String   @id @default(cuid())
  date              DateTime
  timeSlot          String
  status            String   @default("PENDING")
  notes             String?
  customerId        String
  serviceId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  cancelReason      String?
  rescheduledFromId String?
  service           Service  @relation(fields: [serviceId], references: [id])
  customer          User     @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([serviceId, date])
  @@map("appointments")
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String    @default("MEDIUM")
  status      String    @default("PENDING")
  progress    Int       @default(0)
  dueDate     DateTime?
  completedAt DateTime?
  branchId    String?
  assignedTo  String?
  assignedBy  String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branch      Branch?   @relation(fields: [branchId], references: [id])
  creator     User      @relation("TaskCreator", fields: [assignedBy], references: [id])
  assignee    User?     @relation("TaskAssignee", fields: [assignedTo], references: [id])

  @@index([assignedTo])
  @@index([status])
  @@map("tasks")
}

model Feedback {
  id            String    @id @default(cuid())
  rating        Int       @default(0)
  comment       String?
  category      String    @default("GENERAL")
  sentiment     String?
  ticketId      String?
  customerId    String
  isRead        Boolean   @default(false)
  isResolved    Boolean   @default(false)
  adminResponse String?
  respondedAt   DateTime?
  respondedBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ticket        Ticket?   @relation(fields: [ticketId], references: [id])
  customer      User      @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([category])
  @@map("feedbacks")
}

model Notification {
  id           String    @id @default(cuid())
  type         String
  channel      String    @default("IN_APP")
  recipient    String
  subject      String?
  message      String
  status       String    @default("PENDING")
  category     String?
  priority     String?
  sentById     String?
  userId       String?
  templateId   String?
  sentAt       DateTime?
  readAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sentBy       User?     @relation("NotificationSender", fields: [sentById], references: [id])
  user         User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([category])
  @@map("notifications")
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String?
  body      String
  variables String?
  channel   String   @default("IN_APP")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  category    String?

  @@map("system_settings")
}

model QueueRule {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  maxWaitTime       Int      @default(30)
  maxQueueSize      Int      @default(100)
  emergencyPriority Int      @default(100)
  vipPriority       Int      @default(50)
  autoBalance       Boolean  @default(false)
  allowTransfers    Boolean  @default(true)
  allowRecall       Boolean  @default(true)
  branchId          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("queue_rules")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  message   String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("activity_logs")
}

model IntegrationLog {
  id           String   @id @default(cuid())
  direction    String
  system       String
  endpoint     String
  request      String?
  response     String?
  statusCode   Int?
  status       String   @default("PENDING")
  errorMessage String?
  duration     Int?
  createdAt    DateTime @default(now())

  @@index([system, status])
  @@index([createdAt])
  @@map("integration_logs")
}

model ApiLog {
  id         String   @id @default(cuid())
  userId     String?
  method     String
  path       String
  query      String?
  statusCode Int
  duration   Int?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([path])
  @@index([createdAt])
  @@map("api_logs")
}

model SmsLog {
  id           String   @id @default(cuid())
  to           String
  message      String
  status       String   @default("PENDING")
  provider     String   @default("AFRICASTALKING")
  messageId    String?
  cost         Float?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([to])
  @@index([status])
  @@map("sms_logs")
}

model WhatsAppLog {
  id           String   @id @default(cuid())
  to           String
  message      String
  templateName String?
  status       String   @default("PENDING")
  provider     String   @default("TWILIO")
  messageId    String?
  cost         Float?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([to])
  @@index([status])
  @@map("whatsapp_logs")
}

model HospitalAnnouncement {
  id        String    @id @default(cuid())
  title     String
  message   String
  type      String    @default("INFO")
  priority  String    @default("NORMAL")
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  branchId  String?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  branch    Branch?   @relation(fields: [branchId], references: [id])

  @@index([isActive, expiresAt])
  @@map("hospital_announcements")
}

model HealthBulletin {
  id        String   @id @default(cuid())
  title     String
  message   String
  category  String   @default("GENERAL")
  language  String   @default("EN")
  isActive  Boolean  @default(true)
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([isActive, category])
  @@map("health_bulletins")
}

model KioskSession {
  id        String   @id @default(cuid())
  patientId String?
  action    String
  metadata  String?
  branchId  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [patientId], references: [id])

  @@index([createdAt])
  @@map("kiosk_sessions")
}

model Report {
  id           String    @id @default(cuid())
  name         String
  type         String
  category     String
  parameters   String?
  fileUrl      String?
  generatedBy  String?
  status       String    @default("PENDING")
  errorMessage String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([category, status])
  @@map("reports")
}

model ReportSchedule {
  id         String    @id @default(cuid())
  name       String
  category   String
  parameters String?
  recipients String
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("report_schedules")
}
