# SmartQueue — .gitignore

# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# ─── Environment ─────────────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Prisma ──────────────────────────────────────────────────────────────────
backend/prisma/migrations/dev.db
backend/prisma/*.db
backend/prisma/*.db-journal

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
build/
frontend/dist/
backend/dist/

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ─── Docker ──────────────────────────────────────────────────────────────────
# Keep docker-compose.yml but ignore data volumes
postgres_data/
pgadmin_data/

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Cache ───────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.vite/
frontend/.vite/
